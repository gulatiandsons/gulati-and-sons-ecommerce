rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'varungulati.admin@gulatiandsons.com' ||
        request.auth.token.admin == true
      );
    }

    // User Profile Rules
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create, update: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();

      // Sub-collections (e.g. addresses, orders)
      match /{document=**} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Unique Username Reservation Registry
    match /usernames/{username} {
      allow read: if true; // Public read to check availability
      allow create: if isAuthenticated() && request.resource.data.uid == request.auth.uid;
      allow update: if isAuthenticated() && (resource.data.uid == request.auth.uid || request.resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAuthenticated() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Products Catalog
    match /products/{productId} {
      allow read: if true; // Public catalog viewable by patrons
      allow create, update, delete: if isAdmin();
    }

    // Orders Collection
    match /orders/{orderId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerUid == request.auth.uid);
      allow create: if true; // Patron / Guest order placement allowed
      allow update, delete: if isAdmin();
    }

    // Payments Registry
    match /payments/{paymentId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.customerUid == request.auth.uid);
      allow create, update, delete: if isAdmin();
    }

    // Deny all other collections by default
    match /{document=**} {
      allow read, write: if isAdmin();
    }
  }
}
